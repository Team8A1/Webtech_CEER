# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/webtech_ceer

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id

# Allowed Email Domain
ALLOWED_EMAIL_DOMAIN=@kletech.ac.in

# Email (Nodemailer / Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Redis (BullMQ email queue)
# Local dev:   redis://127.0.0.1:6379
# Redis Cloud: redis://:<password>@<host>:<port>
REDIS_URL=redis://127.0.0.1:6379

# Frontend URL (used in email links)
APP_URL=https://webtech-ceer.vercel.app
